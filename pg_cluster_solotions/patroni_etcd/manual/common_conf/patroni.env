# REF: https://patroni.readthedocs.io/en/latest/ENVIRONMENT.html

# General
PATH=/opt/venv/bin:$PATH

# Override some parts of `patroni.yml` with real credentials
# PATRONI_SUPERUSER_USERNAME=postgres
PATRONI_SUPERUSER_PASSWORD=changeme
# PATRONI_REPLICATION_USERNAME=replicator
PATRONI_REPLICATION_PASSWORD=changeme
# PATRONI_REWIND_USERNAME=rewind_user
PATRONI_REWIND_PASSWORD=changeme
